    "domain": "Previously published component norms, coefficients, row metrics and selected labels only; stdlib scalar arithmetic; no tensor/image/model reads or scientific rerun.",
    "rowComparison": "Strictly compare retained capacity/current errorRMS per identical row. Nonzero counts compare predictionRMS or targetRMS to zero.",
    "endpointMinimum": "math.fsum(alpha_i * min_a endpointNorm_i[a]) over all rows; response penalty omitted.",
    "responseMinimum": "math.fsum(beta_e * min_ab responseNorm_e[a][b]) over disjoint pairs; endpoint penalty omitted.",
    "pairResponseMinimumRelativeRMS": "sqrt(fsum(min_ab responseNorm_e[a][b]) / fsum(2560 * targetRMS_e**2)) within the unchanged learned stratum. Denominator is rebuilt from producer row scalars; this does not independently replay coordinates.",
    "scope": "Independent reductions of published producer scalars. Separate endpoint/response minima need not share labels; no new serving program, consumer optimum, fresh generalization or image."
  },
